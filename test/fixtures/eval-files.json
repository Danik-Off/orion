{
  "_": "Фразы про файлы: npm run eval -- --cases test/fixtures/eval-files.json",
  "cases": [
    { "text": "открой папку загрузки", "tool": "open_folder", "arg": "загрузк" },
    { "text": "открой папку проекты", "tool": "open_folder", "arg": "проект" },
    { "text": "найди файл с резюме", "tool": "find_file", "arg": "резюме" },
    { "text": "открой последний pdf", "tool": "find_file", "arg": "^open .*(pdf|пдф)" },
    { "text": "что я последнее скачал", "tool": ["latest_download", "recent_files"] },
    { "text": "что я сегодня скачивал", "tool": "recent_files", "arg": "сегодня" },
    { "text": "какие файлы на рабочем столе", "tool": ["recent_files", "open_folder"], "arg": "рабоч" },
    { "text": "сколько места занимают загрузки", "tool": "folder_info", "arg": "загрузк" },
    { "text": "прочитай файл заметки", "tool": "read_file", "arg": "заметк" },
    { "text": "перескажи последний скачанный документ", "tool": "read_file", "arg": "\\|\\s*summary" },
    { "text": "что написано в договоре про сроки оплаты", "tool": "read_file", "arg": "договор\\s*\\|.*срок" },
    { "text": "переименуй последний скачанный файл в отчёт за сентябрь", "tool": "file_op", "arg": "^rename .*\\|\\s*отч[её]т за сентябрь" },
    { "text": "перемести его на рабочий стол", "before": ["найди файл с резюме"], "tool": "file_op", "arg": "^move (это|его).*\\|\\s*рабоч" },
    { "text": "скопируй договор в документы", "tool": "file_op", "arg": "^copy .*договор.*\\|\\s*документ" },
    { "text": "удали этот файл", "before": ["найди файл с резюме"], "tool": "file_op", "arg": "^delete (это|его|этот)" },
    { "text": "создай на рабочем столе папку отпуск", "tool": "file_op", "arg": "^mkdir отпуск\\s*\\|\\s*рабоч" },
    { "text": "создай текстовый файл список дел", "tool": "file_op", "arg": "^newfile список дел" },
    { "text": "создай на рабочем столе текст документы", "tool": "file_op", "arg": "^newfile" },
    { "text": "скопируй путь к этому файлу", "before": ["найди файл с резюме"], "tool": "file_op", "arg": "^path" },
    { "text": "покажи фото за сегодня", "tool": ["recent_files", "find_file"], "arg": "(фото|изображ).*сегодня|сегодня.*(фото|изображ)" },
    { "text": "найди вчерашний скриншот", "tool": ["find_file", "recent_files"], "arg": "скрин" }
  ]
}
