{
  "name": "orion",
  "productName": "Orion",
  "version": "0.5.0",
  "private": true,
  "description": "Орион — локальный голосовой ассистент в духе джарвис. на Electron + Ollama,максимально простой и удобный в использовании. Поддержка русского языка.",
  "author": {
    "name": "Ovchinnikov Danila",
    "email": "52536804+Danik-Off@users.noreply.github.com"
  },
  "homepage": "https://github.com/Danik-Off/orion",
  "repository": {
    "type": "git",
    "url": "https://github.com/Danik-Off/orion.git"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "models": "node scripts/get-models.js",
    "test": "node --test \"test/**/*.test.js\"",
    "eval": "node scripts/eval.js",
    "eval:holdout": "node scripts/eval.js --cases test/fixtures/eval-holdout.json",
    "icon": "node scripts/make-icon.js",
    "screenshots": "electron scripts/screenshots.js",
    "dist": "npm run icon && node scripts/build-info.js && electron-builder --publish never",
    "dist:dir": "npm run icon && node scripts/build-info.js && electron-builder --dir --publish never",
    "voice-check": "node scripts/voice-check.js",
    "stress-eva": "node scripts/stress-eval.js",
    "stress-phrases": "node scripts/stress-phrases.js",
    "wake-eval": "node scripts/wake-eval.js",
    "speaker-eval": "node scripts/speaker-eval.js",
    "router-dataset": "node scripts/router-dataset.js",
    "router-eval": "node scripts/router-eval.js",
    "router-anonymize": "node scripts/router-anonymize.js",
    "router-release": "node scripts/router-release.js",
    "router-publish": "node scripts/router-release.js --publish",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "build": {
    "appId": "io.github.danik-off.orion",
    "productName": "Orion",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "config.json",
      "package.json",
      "docs/models/orion-router/{NOTICE,GEMMA_TERMS.txt,PROHIBITED_USE_POLICY.txt}",
      "update/*.md",
      "!**/node_modules/**/{README,CHANGELOG,HISTORY,AUTHORS}*",
      "!**/node_modules/**/*.{md,markdown,map,d.ts,d.mts,d.cts,ts}",
      "!**/node_modules/**/{test,tests,__tests__,docs,doc,example,examples,.github}/**"
    ],
    "asarUnpack": [
      "node_modules/sherpa-onnx-*/**"
    ],
    "npmRebuild": false,
    "electronLanguages": [
      "ru",
      "en-US"
    ],
    "compression": "maximum",
    "afterPack": "scripts/after-pack.js",
    "artifactName": "Orion-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "Danik-Off",
        "repo": "orion",
        "releaseType": "draft"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Orion-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": true,
      "include": "installer/installer.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Орион слушает голосовые команды. Распознавание идёт на этом компьютере, звук никуда не отправляется."
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "synopsis": "Локальный голосовой ассистент",
      "maintainer": "Ovchinnikov Danila <52536804+Danik-Off@users.noreply.github.com>"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "electron-updater": "^6.8.9",
    "eyo-kernel": "^4.1.3",
    "sherpa-onnx-node": "^1.13.8"
  }
}
